#!/usr/bin/bash
set -euo pipefail

ssh_dir="$HOME/.ssh"
ssh_key="$ssh_dir/borgwarehouse"

die() {
    echo "Error: $*" >&2
    exit 1
}

require_user() {
    [[ $EUID -ne 0 ]] || die "Run this as your normal user, without sudo."
}

ensure_key() {
    require_user
    install -d -m 0700 "$ssh_dir"
    if [[ ! -f $ssh_key ]]; then
        ssh-keygen -t ed25519 -f "$ssh_key" -N '' -C "borgwarehouse-${USER}@${HOSTNAME}"
    fi
    echo
    echo "BorgWarehouse public key:"
    cat "$ssh_key.pub"
    echo
    echo "Assign this key to the machine's repository in BorgWarehouse."
    echo "In Vorta, use this SSH key and the complete ssh:// repository URL."
}

show_help() {
    cat <<'EOF'

Backup workflow
---------------
Vorta handles normal backups, schedules, archives, checks, and restoring files.
BorgWarehouse stores the encrypted repository on the NAS.

First setup:
  1. Create/show the SSH key with option 1.
  2. Assign the public key to a repository in BorgWarehouse.
  3. Open Vorta from the application menu and add BorgWarehouse's ssh:// URL.
  4. Select your home directory, exclusions, retention, and schedule in Vorta.

Use option 2 only to restore an entire home while the desktop is logged out.
Keep the repository URL and encryption passphrase in Bitwarden.
EOF
}

backup_menu() {
    require_user
    while true; do
        cat <<'EOF'

Backup
======
1. Create or show BorgWarehouse SSH key
2. Restore complete home
3. Show setup instructions
0. Exit
EOF
        read -r -p "Choose an option: " choice
        case "$choice" in
            1) ensure_key ;;
            2) restore_home; return ;;
            3) show_help ;;
            0) return ;;
            *) echo "Choose a number from 0 to 3." ;;
        esac
    done
}

restore_home() {
    require_user
    [[ ${XDG_SESSION_TYPE:-tty} == tty ]] || die "Log out and run this from a text console (Ctrl+Alt+F3)."
    [[ $HOME == /var/home/* || $HOME == /home/* ]] || die "Unexpected home path: $HOME"

    ensure_key
    read -r -p "Repository URL: " repository
    [[ $repository == ssh://* ]] || die "Expected an ssh:// Borg repository URL."
    read -r -s -p "Repository passphrase: " BORG_PASSPHRASE
    echo
    [[ -n $BORG_PASSPHRASE ]] || die "The passphrase may not be empty."
    export BORG_PASSPHRASE
    export BORG_RSH="ssh -i $ssh_key -o IdentitiesOnly=yes"

    echo "Finding the latest archive..."
    archive=$(borg list --last 1 --short "$repository")
    [[ -n $archive ]] || die "No archive was found in the repository."
    echo "Latest archive: $archive"
    echo "This extracts its complete home backup over $HOME. Files created after"
    echo "that backup are not deleted. Your new BorgWarehouse SSH key is preserved."
    read -r -p "Type RESTORE to continue: " confirmation
    [[ $confirmation == RESTORE ]] || die "Restore cancelled."

    key_backup=$(mktemp -d)
    trap 'rm -rf -- "$key_backup"' EXIT
    cp -a "$ssh_key" "$ssh_key.pub" "$key_backup/"

    home_path=${HOME#/}
    (
        cd /
        borg extract --progress "$repository::$archive" "$home_path"
    )

    install -m 0600 "$key_backup/borgwarehouse" "$ssh_key"
    install -m 0644 "$key_backup/borgwarehouse.pub" "$ssh_key.pub"
    echo "Restoring SELinux labels..."
    sudo restorecon -RF "$HOME"
    echo "Restore complete. Reboot before logging into the desktop."
}

case "${1:-}" in
    menu) backup_menu ;;
    key) ensure_key ;;
    restore) restore_home ;;
    *) die "Usage: $0 {menu|key|restore}" ;;
esac
